        {
            "name": "🐙🚀 Run ptbk coder `gpt-5.6-terra` Coding Agent (💤)(💸)(⏳)",
            "commands": [
                "set -a && source .env && set +a",
                "unset OPENAI_API_KEY && unset OPENAI_BASE_URL",
                "npx ptbk coder run --no-questions --harness openai-codex --model gpt-5.6-terra --thinking-level max --agent agents/developer.book --context AGENTS.md --test npm run test-for-ptbk-coder --test-before yes-and-fix  --auto-pull --auto-push --min-priority 1"
